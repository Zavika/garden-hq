{
  "name": "@garden-hq/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "sprites:check": "node --experimental-strip-types vite/check-sprites.ts",
    "icons:make": "node --experimental-strip-types scripts/make-icons.ts"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@garden-hq/core": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "pixi.js": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
